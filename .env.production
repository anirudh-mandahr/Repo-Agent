# Overlay loaded when APP_ENV=production.
# Precedence: real environment > .env.{APP_ENV} > .env > code defaults.
# Secrets (OPENROUTER_API_KEY, ANTHROPIC_API_KEY, NEO4J_PASSWORD,
# GATEWAY_API_KEY, MCP_SHARED_SECRET) must be exported; they are filtered
# out of dotenv files even if present.

LOG_LEVEL=INFO
ORCH_ROUTING_STRATEGY=rules_first
ORCH_RULES_MAX_QUERY_TOKENS=60
ORCH_REQUEST_BUDGETS_ENABLED=true
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_S=60
GATEWAY_MAX_MESSAGE_CHARS=8000
LLM_PROMPT_CACHE=1
INDEXER_CLONE_ALLOWED_HOSTS=github.com
INDEXER_CLONE_ALLOWED_SCHEMES=https
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
