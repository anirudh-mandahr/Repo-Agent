# Copied to .env by `make up` when .env is missing.
# docker-compose.yml interpolates this file; keep compose-level names in sync
# with the prefixed settings that core.settings reads.

# Global
APP_ENV=development
LOG_LEVEL=INFO
REPO_ROOT=/repo
REPO_URL=https://github.com/fastapi/fastapi

# FastMCP bind address interpolated into every agent container.
MCP_HOST=0.0.0.0

# Optional secrets that are not interpolated from committed files:
# export OPENROUTER_API_KEY=...
# export ANTHROPIC_API_KEY=...
# export GATEWAY_API_KEY=...
# export MCP_SHARED_SECRET=...   # defaults to GATEWAY_API_KEY when unset
# GATEWAY_API_KEY is set in docker-compose.yml (default: dev-gateway-key)
# and also used as MCP_SHARED_SECRET for agent-to-agent auth.

# Neo4j — NEO4J_AUTH is what the official image consumes (user/password).
# NEO4J_USER / NEO4J_PASSWORD are used by the cypher-shell healthcheck and
# by indexer / graph_query. Compose requires these values; it does not invent
# a password. Set them in the environment or a private .env:
#   export NEO4J_PASSWORD=...
#   export NEO4J_AUTH=neo4j/$NEO4J_PASSWORD
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# Gateway HTTP bind (compose interpolates GATEWAY_HOST / GATEWAY_PORT)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO
GATEWAY_REQUEST_TIMEOUT_S=10
GATEWAY_RETRY_COUNT=1
GATEWAY_MODEL_NAME=anthropic/claude-sonnet-4.5
GATEWAY_TOKEN_BUDGET=3000
GATEWAY_CACHE_TTL_SECONDS=300
GATEWAY_HEALTH_TIMEOUT_S=2
GATEWAY_CHAT_TIMEOUT_S=90
GATEWAY_ANSWER_CHUNK_CHARS=160
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_S=60
GATEWAY_MAX_MESSAGE_CHARS=8000

# Gateway MCP URLs — GATEWAY_* prefix for settings.py; *_MCP_URL for compose.
GATEWAY_ORCHESTRATOR_URL=http://orchestrator:8001/mcp
GATEWAY_INDEXER_URL=http://indexer:8002/mcp
GATEWAY_GRAPH_QUERY_URL=http://graph_query:8003/mcp
GATEWAY_CODE_ANALYST_URL=http://code_analyst:8004/mcp
GATEWAY_MEMORY_URL=http://memory:8005/mcp
ORCHESTRATOR_MCP_URL=http://orchestrator:8001/mcp
INDEXER_MCP_URL=http://indexer:8002/mcp
GRAPH_QUERY_MCP_URL=http://graph_query:8003/mcp
CODE_ANALYST_MCP_URL=http://code_analyst:8004/mcp
MEMORY_MCP_URL=http://memory:8005/mcp

# Orchestrator
ORCH_HOST=0.0.0.0
ORCH_PORT=8001
ORCH_LOG_LEVEL=INFO
ORCH_REQUEST_TIMEOUT_S=10
ORCH_RETRY_COUNT=1
ORCH_MODEL_NAME=anthropic/claude-sonnet-4.5
ORCH_TOKEN_BUDGET=3000
ORCH_CACHE_TTL_SECONDS=300
ORCH_ROUTING_STRATEGY=rules_first
ORCH_RULES_MAX_QUERY_TOKENS=60
ORCH_GRAPH_QUERY_TIMEOUT_S=5
ORCH_CODE_ANALYST_TIMEOUT_S=15
ORCH_INDEXER_TIMEOUT_S=30
ORCH_SYNTHESIS_TIMEOUT_S=20
ORCH_SYNTHESIS_PROMPT_TOKEN_BUDGET=12000
ORCH_SYNTHESIS_SAFETY_MARGIN_S=2
# Floor for a typical synthesis prompt. Runtime reserve scales up with prompt tokens.
ORCH_SYNTHESIS_RESERVE_S=20
ORCH_MAX_PLAN_ITERATIONS=2
ORCH_PLAN_DEADLINE_S=35
ORCH_REQUEST_DEADLINE_S=55
ORCH_REQUEST_TOKEN_BUDGET=50000
ORCH_REQUEST_COST_USD_MAX=0.15
ORCH_REQUEST_BUDGETS_ENABLED=true
ORCH_BREAKER_FAILURE_THRESHOLD=3
ORCH_BREAKER_COOLDOWN_S=30
# Per-agent overrides (blank = use ORCH_BREAKER_* defaults):
# ORCH_BREAKER_GRAPH_QUERY_FAILURE_THRESHOLD=3
# ORCH_BREAKER_GRAPH_QUERY_COOLDOWN_S=30
# ORCH_BREAKER_CODE_ANALYST_FAILURE_THRESHOLD=3
# ORCH_BREAKER_CODE_ANALYST_COOLDOWN_S=30
# ORCH_BREAKER_INDEXER_FAILURE_THRESHOLD=3
# ORCH_BREAKER_INDEXER_COOLDOWN_S=30
# ORCH_BREAKER_MEMORY_FAILURE_THRESHOLD=3
# ORCH_BREAKER_MEMORY_COOLDOWN_S=30

# Indexer — INDEXER_SKIP_* is the settings prefix; INDEX_SKIP_* is what
# docker-compose.yml interpolates. Keep the pairs equal. settings.py accepts both.
# Default is a full index (tests/ and docs/ included). Fast profile:
#   INDEXER_SKIP_TESTS=1 INDEXER_SKIP_DOCS=1
#   INDEX_SKIP_TESTS=1 INDEX_SKIP_DOCS=1
INDEXER_HOST=0.0.0.0
INDEXER_PORT=8002
INDEXER_LOG_LEVEL=INFO
INDEXER_REQUEST_TIMEOUT_S=30
INDEXER_RETRY_COUNT=1
INDEXER_MODEL_NAME=anthropic/claude-sonnet-4.5
INDEXER_TOKEN_BUDGET=3000
INDEXER_CACHE_TTL_SECONDS=300
INDEXER_SKIP_TESTS=0
INDEXER_SKIP_DOCS=0
INDEX_SKIP_TESTS=0
INDEX_SKIP_DOCS=0
INDEXER_REPORT_PATH=/tmp/index_report.json
INDEXER_CLONE_ALLOWED_HOSTS=github.com
INDEXER_CLONE_ALLOWED_SCHEMES=https

# Graph Query
GQ_HOST=0.0.0.0
GQ_PORT=8003
GQ_LOG_LEVEL=INFO
GQ_REQUEST_TIMEOUT_S=10
GQ_RETRY_COUNT=1
GQ_MODEL_NAME=anthropic/claude-sonnet-4.5
GQ_TOKEN_BUDGET=3000
GQ_CACHE_TTL_SECONDS=300
# Hash-based lexical fallback (256-dim bag-of-words hash), not a semantic model.
# Default off. The flag is authoritative; injecting a provider does not enable it.
# Set to 1 to run the third find_entity cascade tier against stored hash vectors.
GQ_EMBEDDINGS_ENABLED=0

# Code Analyst
CA_HOST=0.0.0.0
CA_PORT=8004
CA_LOG_LEVEL=INFO
CA_REQUEST_TIMEOUT_S=15
CA_RETRY_COUNT=1
CA_MODEL_NAME=anthropic/claude-sonnet-4.5
CA_TOKEN_BUDGET=3000
CA_CACHE_TTL_SECONDS=300
CA_GRAPH_QUERY_URL=http://graph_query:8003/mcp

# Memory
MEM_HOST=0.0.0.0
MEM_PORT=8005
MEM_LOG_LEVEL=INFO
MEM_REQUEST_TIMEOUT_S=10
MEM_RETRY_COUNT=1
MEM_MODEL_NAME=anthropic/claude-sonnet-4.5
MEM_TOKEN_BUDGET=3000
MEM_CACHE_TTL_SECONDS=86400
MEM_DB_PATH=/data/memory.db
MEM_RECENT_TURNS=6

# LLM provider. Compose interpolates these into orchestrator, code_analyst,
# and memory. An empty key selects OfflineProvider; set a real key (here or
# via `export OPENROUTER_API_KEY=...`) for live answers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-purpose overrides (blank = fall back to OPENROUTER_MODEL, except
# synthesis which defaults to openai/gpt-4.1-mini from bake-off p95/cost).
# ORCH_MODEL_ROUTING=
ORCH_MODEL_SYNTHESIS=openai/gpt-4.1-mini
# CA_MODEL_ANALYSIS=
# Per-1M USD rates used by the token ledger. Overlay JSON wins per model.
LLM_PROMPT_USD_PER_MILLION=3.0
LLM_COMPLETION_USD_PER_MILLION=15.0
LLM_CACHED_PROMPT_USD_PER_MILLION=0.30
# LLM_MODEL_PRICES_JSON={"anthropic/claude-haiku-4.5":{"prompt":0.5,"completion":2.5,"cached_prompt":0.05}}
LLM_PROMPT_CACHE=1

# Tracing. Blank disables the OTLP exporter; spans still record in-process.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Bounded MCP client sessions per upstream agent (gateway, orchestrator, code_analyst).
MCP_SESSION_POOL_SIZE=4
