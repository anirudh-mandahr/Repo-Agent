# Copied to .env by `make up` when .env is missing.
# docker-compose.yml interpolates this file; keep compose-level names in sync
# with the prefixed settings that core.settings reads.

# Global
APP_ENV=development
LOG_LEVEL=INFO
REPO_ROOT=/repo
REPO_URL=https://github.com/fastapi/fastapi

# FastMCP bind address interpolated into every agent container.
MCP_HOST=0.0.0.0

# Optional secrets that are not interpolated by compose:
# export GATEWAY_API_KEY=...
# export ANTHROPIC_API_KEY=...

# Neo4j — NEO4J_AUTH is what the official image consumes (user/password).
# NEO4J_USER / NEO4J_PASSWORD are used by the cypher-shell healthcheck and
# by indexer / graph_query. Local-dev default matches CI.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_AUTH=neo4j/changeme123

# Gateway HTTP bind (compose interpolates GATEWAY_HOST / GATEWAY_PORT)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO
GATEWAY_REQUEST_TIMEOUT_S=10
GATEWAY_RETRY_COUNT=1
GATEWAY_MODEL_NAME=anthropic/claude-sonnet-4.5
GATEWAY_TOKEN_BUDGET=3000
GATEWAY_CACHE_TTL_SECONDS=300
GATEWAY_HEALTH_TIMEOUT_S=2
GATEWAY_ANSWER_CHUNK_CHARS=160

# Gateway MCP URLs — GATEWAY_* prefix for settings.py; *_MCP_URL for compose.
GATEWAY_ORCHESTRATOR_URL=http://orchestrator:8001/mcp
GATEWAY_INDEXER_URL=http://indexer:8002/mcp
GATEWAY_GRAPH_QUERY_URL=http://graph_query:8003/mcp
GATEWAY_CODE_ANALYST_URL=http://code_analyst:8004/mcp
GATEWAY_MEMORY_URL=http://memory:8005/mcp
ORCHESTRATOR_MCP_URL=http://orchestrator:8001/mcp
INDEXER_MCP_URL=http://indexer:8002/mcp
GRAPH_QUERY_MCP_URL=http://graph_query:8003/mcp
CODE_ANALYST_MCP_URL=http://code_analyst:8004/mcp
MEMORY_MCP_URL=http://memory:8005/mcp

# Orchestrator
ORCH_HOST=0.0.0.0
ORCH_PORT=8001
ORCH_LOG_LEVEL=INFO
ORCH_REQUEST_TIMEOUT_S=10
ORCH_RETRY_COUNT=1
ORCH_MODEL_NAME=anthropic/claude-sonnet-4.5
ORCH_TOKEN_BUDGET=3000
ORCH_CACHE_TTL_SECONDS=300
ORCH_GRAPH_QUERY_TIMEOUT_S=5
ORCH_CODE_ANALYST_TIMEOUT_S=15
ORCH_INDEXER_TIMEOUT_S=30
ORCH_SYNTHESIS_TIMEOUT_S=20

# Indexer — INDEXER_SKIP_* is the settings prefix; INDEX_SKIP_* is what
# docker-compose.yml interpolates. Keep the pairs equal. settings.py accepts both.
INDEXER_HOST=0.0.0.0
INDEXER_PORT=8002
INDEXER_LOG_LEVEL=INFO
INDEXER_REQUEST_TIMEOUT_S=30
INDEXER_RETRY_COUNT=1
INDEXER_MODEL_NAME=anthropic/claude-sonnet-4.5
INDEXER_TOKEN_BUDGET=3000
INDEXER_CACHE_TTL_SECONDS=300
INDEXER_SKIP_TESTS=1
INDEXER_SKIP_DOCS=1
INDEX_SKIP_TESTS=1
INDEX_SKIP_DOCS=1
INDEXER_REPORT_PATH=/tmp/index_report.json

# Graph Query
GQ_HOST=0.0.0.0
GQ_PORT=8003
GQ_LOG_LEVEL=INFO
GQ_REQUEST_TIMEOUT_S=10
GQ_RETRY_COUNT=1
GQ_MODEL_NAME=anthropic/claude-sonnet-4.5
GQ_TOKEN_BUDGET=3000
GQ_CACHE_TTL_SECONDS=300

# Code Analyst
CA_HOST=0.0.0.0
CA_PORT=8004
CA_LOG_LEVEL=INFO
CA_REQUEST_TIMEOUT_S=15
CA_RETRY_COUNT=1
CA_MODEL_NAME=anthropic/claude-sonnet-4.5
CA_TOKEN_BUDGET=3000
CA_CACHE_TTL_SECONDS=300
CA_GRAPH_QUERY_URL=http://graph_query:8003/mcp

# Memory
MEM_HOST=0.0.0.0
MEM_PORT=8005
MEM_LOG_LEVEL=INFO
MEM_REQUEST_TIMEOUT_S=10
MEM_RETRY_COUNT=1
MEM_MODEL_NAME=anthropic/claude-sonnet-4.5
MEM_TOKEN_BUDGET=3000
MEM_CACHE_TTL_SECONDS=86400
MEM_DB_PATH=/data/memory.db
MEM_RECENT_TURNS=6

# LLM provider. Compose interpolates these into orchestrator, code_analyst,
# and memory. An empty key selects OfflineProvider; set a real key (here or
# via `export OPENROUTER_API_KEY=...`) for live answers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
